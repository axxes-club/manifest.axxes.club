# Shared AXXES Neon database (same as members.axxes.club).
# For local development use the disposable database instead (npm run db:local):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5499/postgres
DATABASE_URL=
# Must match members.axxes.club so both apps accept the same accounts
BETTER_AUTH_SECRET=
# Public URL of this app, e.g. https://manifest.axxes.club
BETTER_AUTH_URL=
# Central AXXES sign-in. Leave empty to use Manifest's own sign-in page.
HANDSHAKE_URL=
# Share one session across *.axxes.club (production: axxes.club)
AUTH_COOKIE_DOMAIN=
